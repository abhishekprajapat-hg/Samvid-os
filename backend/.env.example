# Copy this file to backend/.env and fill real values locally or on the VPS.
# Never commit backend/.env or real secrets.

NODE_ENV=development
# BillStack integration. Backend only; leave empty to disable.
BILLSTACK_BASE_URL=
BILLSTACK_FRONTEND_URL=
BILLSTACK_API_KEY=
BILLSTACK_COMPANY_ID=
PORT=5000

# Preferred local mode: SSH tunnel to the VPS MongoDB.
# Example tunnel:
# ssh -L 27018:127.0.0.1:27017 root@YOUR_VPS_IP
# Example local tunneled URI:
# MONGO_URI=mongodb://office_app:STRONG_PASSWORD@127.0.0.1:27018/the_office_on_rent?authSource=the_office_on_rent
#
# Example production URI on the VPS:
# MONGO_URI=mongodb://office_app:STRONG_PASSWORD@127.0.0.1:27017/the_office_on_rent?authSource=the_office_on_rent
MONGO_URI=mongodb://office_app:STRONG_PASSWORD@127.0.0.1:27018/the_office_on_rent?authSource=the_office_on_rent

# Generate a strong secret with at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated exact frontend origins allowed to call this backend.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Use 1/true behind Nginx or another trusted reverse proxy in production.
TRUST_PROXY=false

MONGO_MAX_POOL_SIZE=25
MONGO_MIN_POOL_SIZE=1
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Production/shared DB seed guard.
# Leave false by default. Set true only after taking a backup and confirming a
# seed/backfill/migration should write to the shared VPS database.
ALLOW_SHARED_DB_SEED=false

# Optional runtime tuning.
MONGO_AUTO_INDEX=false
MONGO_CONNECT_RETRY_DELAY_MS=3000
MONGO_CONNECT_MAX_RETRIES=0
LOG_LEVEL=info
METRICS_BEARER_TOKEN=replace-with-a-long-random-token

# Uploaded files (images/documents/chat media) are stored on local disk and served under
# /api/uploads/files. UPLOAD_DIR defaults to backend/uploads; set an absolute path to store
# elsewhere on the VPS. UPLOAD_MAX_FILE_SIZE_BYTES defaults to 25MB.
# UPLOAD_DIR=uploads
# UPLOAD_MAX_FILE_SIZE_BYTES=26214400

# Used only by the one-off migrateCloudinaryUploads script to build absolute URLs when
# rewriting existing Cloudinary URLs (no request context to infer host/protocol from).
# PUBLIC_ORIGIN=https://crm.theofficeonrent.com

# Web push (VAPID). Generate with: npx web-push generate-vapid-keys
# Leave blank to disable push - the CRM runs normally, only push stays off.
# VAPID_PRIVATE_KEY is a secret: set it on the server only, never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:theofficeonrent.ws@gmail.com

# ---------------------------------------------------------------------------
# Employee page-access enforcement
#
# Controls whether the per-role page defaults in rolePageAccess.constants.js are
# enforced by the API. An explicit per-employee override is ALWAYS enforced
# regardless of this setting.
#
#   log  (default) allow the request, but log every call that enforcement would
#                  have denied. Grep for "would deny under enforcement" before
#                  switching over.
#   on             enforce. Measured impact on the audited dataset: 14 calls
#                  newly denied, 0 newly allowed. Note that COWORKING_ADMIN has
#                  no "attendance" page in its defaults, so that role loses
#                  check-in/leave - add the page to COWORKING_ADMIN_PAGES first
#                  if coworking admins are expected to mark attendance.
#   off            previous behaviour: role defaults are advisory only.
PAGE_ACCESS_ENFORCEMENT=log

# ---------------------------------------------------------------------------
# Uploaded-file access
#
# Files under /api/uploads/files require a credential: a staff bearer token, the
# httpOnly cookie issued at login, or a per-URL signed token. The cookie is what
# lets <img> and <a> load a file, and it is marked Secure when
# NODE_ENV=production - so the app MUST be served over HTTPS in production or
# images will not load.
FILE_ACCESS_COOKIE_TTL=12h
FILE_ACCESS_COOKIE_MAX_AGE_SECONDS=43200
# Lifetime of the per-URL token used by public inventory share links.
FILE_ACCESS_URL_TTL=30m

# Maximum stored dimension for uploaded photographs (handled by sharp on
# upload). Non-images and animated formats pass through untouched.
UPLOAD_MAX_FILE_SIZE_BYTES=26214400
