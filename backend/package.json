    "sync:vps-to-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-vps-to-local.ps1",
    "db:test-connection": "node src/scripts/testDbConnection.cjs",
    "start": "node src/server.js",
    "seed:admin": "node src/seeder/createAdmin.cjs",
