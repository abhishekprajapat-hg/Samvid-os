{
  "name": "samvid-os",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client --tunnel --port 19020 --clear",
    "start:lan": "expo start --dev-client --lan --port 19020 --clear",
    "start:tunnel": "expo start --dev-client --tunnel --port 19020 --clear",
    "start:go": "expo start --go --tunnel --port 19020 --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --clear",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e": "maestro test e2e/maestro",
    "test:e2e:smoke": "maestro test e2e/maestro/android/smoke.yaml",
    "test:e2e:android": "maestro test e2e/maestro/android",
    "test:e2e:ios": "maestro test e2e/maestro/ios",
    "test:e2e:docs": "node -e \"console.log('Maestro flows live in e2e/maestro. See e2e/README.md for Android and iOS setup.')\"",
    "build:apk": "eas build --platform android --profile development",
    "build:apk:preview": "eas build --platform android --profile preview",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc src/navigation/access.ts src/navigation/navigationCatalogue.ts src/modules/leads/pipelineViews.ts src/modules/leads/leadFilters.ts src/modules/inventory/inventoryAccess.ts src/modules/admin/consoleActions.ts src/theme/themedStyles.ts src/utils/liveLocationRules.ts src/modules/coworking/boardReducer.ts src/modules/chat/chatReceipts.ts src/modules/leads/followUpReminders.ts src/context/realtimeEvents.ts src/modules/leads/bulkLeadUpload.ts src/modules/inventory/projectForm.ts src/modules/inventory/contactBulkImport.ts src/modules/reports/intelligence.ts src/modules/leads/leadRequirements.ts src/modules/inventory/inventoryForm.ts --outDir .test-build --module commonjs --target es2020 --skipLibCheck --esModuleInterop",
    "test": "node --test \"test/**/*.test.cjs\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.3.28",
    "axios": "^1.12.2",
    "expo": "~54.0.23",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-modules-core": "3.0.29",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech-recognition": "^3.1.1",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.16",
    "jspdf": "^4.2.0",
    "lucide-react-native": "^0.574.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "13.15.0",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "axios-mock-adapter": "^1.22.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native": "0.81.5",
    "@react-native/virtualized-lists": "0.81.5"
  },
  "private": true
}
