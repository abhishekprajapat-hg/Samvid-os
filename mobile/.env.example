EXPO_PUBLIC_API_BASE_URL=https://nemnidhi.cloud/api
EXPO_PUBLIC_SOCKET_URL=https://nemnidhi.cloud
EXPO_PUBLIC_SOCKET_PATH=/socket.io

# Where the web app is served, for links meant to open in a browser (share
# links, legal pages). Defaults to the API base URL with /api removed.
# EXPO_PUBLIC_WEB_APP_URL=https://nemnidhi.cloud

# Optional local API mode for Expo dev
# EXPO_PUBLIC_USE_LOCAL_API=true
# EXPO_PUBLIC_LOCAL_API_PORT=4000

# Optional address search, matching web's VITE_ settings. Without these,
# property addresses use OpenStreetMap and lead localities are plain typing.
# The key must allow the Places web-service API (not a browser-restricted key).
# EXPO_PUBLIC_LOCATION_PROVIDER=google
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-places-key
# EXPO_PUBLIC_GOOGLE_MAPS_PLACES_COUNTRY=in

# Optional TURN relay for reliable mobile-data calls (recommended in production)
# EXPO_PUBLIC_TURN_URL=turn:your-turn-host:3478
# EXPO_PUBLIC_TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:5349
# EXPO_PUBLIC_TURN_USERNAME=your-username
# EXPO_PUBLIC_TURN_CREDENTIAL=your-password
